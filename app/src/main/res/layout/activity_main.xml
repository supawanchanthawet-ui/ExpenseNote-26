<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8B4513"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5DEB3"
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="บันทึกค่าใช้จ่ายประจำวัน"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#B22222"
            android:layout_marginBottom="4dp"
            android:layout_gravity="center"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="จดทุกบาทที่ใช้วันนี้ให้ครบเลยนะ"
            android:textSize="14sp"
            android:textColor="#006400"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
            android:textColor="#0000FF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="เช่น 100 หรือ 10.25"
            android:textColor="#FF33CC"
            android:textColorHint="#FF0099"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="คำอธิบาย"
            android:textColor="#660000"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#CC6699"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:hint="เช่น กลางวัน ค่าเดินทาง"
            android:textColor="#99FF99"
            android:textColorHint="#990066"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center">

            <Button
                android:id="@+id/btnclear"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="เคลียร์"
                android:textAllCaps="false"
                android:background="#99FF00"
                android:textColor="#FF0000"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="เพิ่มรายการ"
                android:textAllCaps="false"
                android:background="@color/cardview_dark_background"
                android:textColor="#33FF00"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvLastItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="รายการล่าสุด"
            android:textColor="@color/cardview_dark_background"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ยอดรวม"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#66CC00"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>